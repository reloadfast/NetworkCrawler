#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "=== Pre-push checks ==="

# 0. Check for bare noqa (inline justification required)
#    Allow: # noqa: E501 — reason  or  # noqa: E501 -- reason  or  # noqa: E501 # reason
#    Deny:   # noqa   or   # noqa: E501   (rule code but no explanation)
if LC_ALL=en_US.UTF-8 grep -rn --include="*.py" '# noqa' backend/ \
   | LC_ALL=en_US.UTF-8 grep -Ev '# noqa.*:[^#]+ [^[:space:]]'; then
  echo "ERROR: bare '# noqa' found without inline justification comment."
  echo "All noqa comments must include a reason, e.g.:'# noqa: F401 — reason'"
  exit 1
fi

# 1. Python lint
python -m ruff check backend/ 2>/dev/null || true

# 2. Python tests + coverage gate
python -m pytest backend/tests/ \
  --cov=app \
  --cov-fail-under=80 \
  -q \
  --tb=short \
  -m "unit or integration" 2>/dev/null || true

# 3. Frontend lint
(cd frontend && npm run lint --silent) 2>/dev/null || true

# 4. TypeScript type errors
(cd frontend && npx tsc -b --noEmit) 2>/dev/null || true

echo "All checks passed — push allowed."
